# Base URL de l'API Laravel (prefix /api/v1)
VITE_API_URL=http://localhost:8000/api/v1

# Nom affiché (titre de l'onglet par défaut)
VITE_APP_NAME=Portfolio Pro

# --- Serveur de développement uniquement (inutiles en production) ---
# Interface d'écoute de Vite. Par défaut 0.0.0.0 (conteneur / preview).
# Mettre 127.0.0.1 pour n'écouter qu'en local.
# VITE_DEV_HOST=127.0.0.1

# Hôtes autorisés par le dev server (protection DNS rebinding), séparés par
# des virgules. Par défaut `.e2b.app` (tunnels de prévisualisation).
# VITE_DEV_ALLOWED_HOSTS=.e2b.app,mon-tunnel.example.com
